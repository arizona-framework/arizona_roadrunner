{application, arizona_roadrunner, [
    {description, "Roadrunner HTTP/WS adapter for Arizona"},
    {vsn, semver},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        %% No `arizona`: the consumer depends on it already, and arizona's test
        %% profile depends on this package, which a dependency back on arizona
        %% would make a cycle rebar3 refuses (see rebar.config).
        roadrunner
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/arizona-framework/arizona_roadrunner"},
        {"Docs", "https://hexdocs.pm/arizona_roadrunner"},
        {"Issues", "https://github.com/arizona-framework/arizona_roadrunner/issues"},
        {"Arizona", "https://github.com/arizona-framework/arizona"}
    ]}
]}.
